rules_version = '2';
// ============================================================
//  Firestore セキュリティルール
//  - news / events  : 誰でも閲覧可、管理者のみ書き込み可
//  - contacts       : 誰でも送信（作成）可、閲覧・削除は管理者のみ
//  - admins         : 管理者の UID を登録（コンソールから手動で追加）
//  - members        : 本人が「審査中」で申込、本人は一部項目のみ編集可、承認は管理者
//  - member_news / member_docs : 有効な会員のみ閲覧、管理者のみ書き込み
//  - rsvps          : 有効な会員が自分の参加登録のみ作成・取消
//  - student_ids    : 学生会員の学生証（表面）の画像。本人が申込時に登録、閲覧は本人と管理者
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveMember() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- 公開コンテンツ ----------
    match /news/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }

    // ---------- お問い合わせ ----------
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['subject', 'name', 'email', 'message', 'createdAt'])
        && str(request.resource.data.name, 100)
        && str(request.resource.data.email, 200)
        && str(request.resource.data.message, 5000)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---------- 管理者（role: owner = オーナー / admin = 管理者） ----------
    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
    // 本人あての招待があり、メールアドレスが確認済み（Google ログインは常に確認済み）
    function hasVerifiedInvite() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_invites/$(request.auth.token.email.lower()));
    }

    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // 招待された本人が、自分を「管理者」として登録する（オーナーにはなれない）
      allow create: if hasVerifiedInvite()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'invitedBy', 'createdAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      // 役割の変更は不可。削除（管理者の解除）はオーナーのみ、オーナー自身は削除不可
      allow update: if false;
      allow delete: if isOwner() && resource.data.role != 'owner';
    }

    // ---------- 会員証の確認ページ用（QRコードの番号を知っている人だけが1件ずつ読める） ----------
    // 書き込みは Cloud Functions（syncMemberCard）のみ
    match /cards/{token} {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------- 会員番号の連番カウンター（管理者のみ） ----------
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- 管理者への招待（ID = 小文字のメールアドレス） ----------
    match /admin_invites/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email.lower() == email);
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'name', 'invitedBy', 'createdAt'])
        && request.resource.data.email == email
        && request.resource.data.invitedBy == request.auth.uid
        && str(request.resource.data.name, 100)
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner() || hasVerifiedInvite() && request.auth.token.email.lower() == email;
      allow update: if false;
    }

    // ---------- 会員 ----------
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // 入会申込（本人・審査中のみ）
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'kana', 'email', 'type', 'occupation', 'affiliation', 'phone',
             'address', 'message', 'newsletter', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['regular', 'associate', 'student']
        && str(request.resource.data.name, 100)
        && str(request.resource.data.kana, 100)
        && str(request.resource.data.email, 200)
        && str(request.resource.data.message, 2000)
        && str(request.resource.data.occupation, 50)
        && request.resource.data.createdAt == request.time;

      // 委員会承認制：状態（status）を変えられるのは管理者のみ。
      // 「有効」にするときは承認した管理者（approvedBy）の記録を必須にする。
      // 本人は名前・連絡先などのプロフィールだけ編集可（状態・会員番号などは変更不可）
      allow update: if (isAdmin()
          && (request.resource.data.status != 'active' || request.resource.data.approvedBy is string))
        || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'kana', 'occupation', 'affiliation', 'phone', 'address', 'newsletter'])
        && str(request.resource.data.name, 100));

      allow delete: if isAdmin();
    }

    // ---------- 学生証の画像（ID = 会員の UID、学生会員の申込時のみ） ----------
    // 本人が審査中の間だけ登録・差し替え可。閲覧は本人と管理者、削除は管理者のみ
    match /student_ids/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/members/$(uid)).data.status == 'pending'
        && get(/databases/$(database)/documents/members/$(uid)).data.type == 'student'
        && request.resource.data.keys().hasOnly(['image', 'createdAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 900000
        && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    match /member_news/{id} { allow read: if isActiveMember() || isAdmin(); allow write: if isAdmin(); }
    match /member_docs/{id} { allow read: if isActiveMember() || isAdmin(); allow write: if isAdmin(); }

    // ---------- 行事の参加登録（ID = 行事ID_UID） ----------
    match /rsvps/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActiveMember()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'name', 'createdAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
