rules_version = '2';
// ============================================================
//  Firestore セキュリティルール
//  - news / events  : 誰でも閲覧可、管理者のみ書き込み可
//  - contacts       : 誰でも送信（作成）可、閲覧・削除は管理者のみ
//  - admins         : 管理者の UID を登録（コンソールから手動で追加）
//  - members        : 本人が「審査中」で申込、本人は一部項目のみ編集可、承認は管理者
//  - member_news / member_docs : 有効な会員のみ閲覧、管理者のみ書き込み
//  - rsvps          : 有効な会員が自分の参加登録のみ作成・取消
//  - student_ids    : 学生会員の学生証（表面）の画像。本人が申込時に登録、閲覧は本人と管理者
//  - consent_forms / consent_signatures : 電子同意書と署名の記録（公開後の本文・署名は変更不可）
//  - board_groups / settings / reviews : 理事会による入会審査（理由は管理者のみ閲覧。申込者には非公開）
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveMember() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- 公開コンテンツ ----------
    match /news/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }

    // ---------- お問い合わせ ----------
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['subject', 'name', 'email', 'message', 'createdAt'])
        && str(request.resource.data.name, 100)
        && str(request.resource.data.email, 200)
        && str(request.resource.data.message, 5000)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---------- 管理者（role: owner = オーナー / admin = 管理者） ----------
    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
    // 本人あての招待があり、メールアドレスが確認済み（Google ログインは常に確認済み）
    function hasVerifiedInvite() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_invites/$(request.auth.token.email.lower()));
    }

    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // 招待された本人が、自分を「管理者」として登録する（オーナーにはなれない）
      allow create: if hasVerifiedInvite()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'invitedBy', 'createdAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      // 役割の変更は不可。削除（管理者の解除）はオーナーのみ、オーナー自身は削除不可
      allow update: if false;
      allow delete: if isOwner() && resource.data.role != 'owner';
    }

    // ---------- 会員証の確認ページ用（QRコードの番号を知っている人だけが1件ずつ読める） ----------
    // 書き込みは Cloud Functions（syncMemberCard）のみ
    match /cards/{token} {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------- 会員番号の連番カウンター（管理者のみ） ----------
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- 管理者への招待（ID = 小文字のメールアドレス） ----------
    match /admin_invites/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email.lower() == email);
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'name', 'invitedBy', 'createdAt'])
        && request.resource.data.email == email
        && request.resource.data.invitedBy == request.auth.uid
        && str(request.resource.data.name, 100)
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner() || hasVerifiedInvite() && request.auth.token.email.lower() == email;
      allow update: if false;
    }

    // ---------- 会員 ----------
    // 会員証の署名の登録・書き直し（本人による更新）
    //  ・まだ署名が無ければ自由に登録できる
    //  ・登録済みの署名の書き直しは、管理者が許可（signatureRewrite = 'allowed'）した場合のみ 1 回。
    //    書き直すときに許可を消す（使い切り）
    //  ・本人ができるのは「書き直しを申請（'requested'）」まで
    function selfSignatureOk() {
      let before = resource.data;
      let after = request.resource.data;
      let sigChanged = after.get('cardSignature', null) != before.get('cardSignature', null);
      let rwBefore = before.get('signatureRewrite', null);
      let rwAfter = after.get('signatureRewrite', null);
      return (!sigChanged || before.get('cardSignature', null) == null || (rwBefore == 'allowed' && rwAfter == null))
        && (rwAfter == rwBefore
            || (rwAfter == 'requested' && rwBefore == null && !sigChanged)
            || (rwAfter == null && rwBefore == 'allowed' && sigChanged));
    }
    // 会員種別の変更申請（本人による更新）
    //  ・本人ができるのは「申請（typeRequest に変更先の種別）」と「申請の取り消し（消す）」だけ。種別（type）そのものは変更できない
    //  ・申請中に別の種別へ出し直すことはできない（いったん取り消してから）
    //  ・許可・却下は管理者のみ（管理者の更新）
    function selfTypeRequestOk() {
      let before = resource.data;
      let after = request.resource.data;
      let rqBefore = before.get('typeRequest', null);
      let rqAfter = after.get('typeRequest', null);
      return rqAfter == rqBefore
        || rqAfter == null
        || (rqBefore == null && before.status == 'active'
            && rqAfter in ['regular', 'associate', 'student'] && rqAfter != before.type
            && str(after.get('typeRequestReason', ''), 500));
    }
    // 会員証の裏面の直筆署名（任意項目。PNG 画像・300KB まで）
    function validCardSignature(d) {
      return !('cardSignature' in d)
        || (d.cardSignature is string && d.cardSignature.size() <= 300000 && d.cardSignature.matches('^data:image/png;base64,.*'));
    }
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // 入会申込（本人・審査中のみ）
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'kana', 'email', 'type', 'occupation', 'affiliation', 'phone',
             'address', 'message', 'newsletter', 'cardSignature', 'status', 'createdAt'])
        && validCardSignature(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['regular', 'associate', 'student']
        && str(request.resource.data.name, 100)
        && str(request.resource.data.kana, 100)
        && str(request.resource.data.email, 200)
        && str(request.resource.data.message, 2000)
        && str(request.resource.data.occupation, 50)
        && request.resource.data.createdAt == request.time;

      // 委員会承認制：状態（status）を変えられるのは管理者のみ。
      // 「有効」にするときは承認した管理者（approvedBy）の記録を必須にする。
      // 本人は名前・連絡先などのプロフィールだけ編集可（状態・会員番号などは変更不可）
      allow update: if (isAdmin()
          && (request.resource.data.status != 'active' || request.resource.data.approvedBy is string))
        || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'kana', 'occupation', 'affiliation', 'phone', 'address', 'newsletter', 'cardSignature', 'signatureRewrite', 'signatureRewriteAt', 'email',
                       'typeRequest', 'typeRequestReason', 'typeRequestAt'])
        && validCardSignature(request.resource.data)
        && selfSignatureOk()
        && selfTypeRequestOk()
        // メールアドレスは、ログイン中のアカウント（確認済み）のアドレスに合わせる場合のみ
        && (request.resource.data.get('email', '') == resource.data.get('email', '')
            || (request.auth.token.email_verified == true && request.resource.data.email == request.auth.token.email))
        && str(request.resource.data.name, 100));

      allow delete: if isAdmin();
    }

    // ---------- 学生証の画像（ID = 会員の UID、学生会員の申込時のみ） ----------
    // 本人が審査中の間だけ登録・差し替え可。閲覧は本人と管理者、削除は管理者のみ
    // 学生証を提出できるのは「審査中の学生会員（入会申込）」か「学生会員への種別変更を申請中の有効会員」
    function studentIdAllowed(m) {
      return (m.status == 'pending' && m.type == 'student')
        || (m.status == 'active' && m.get('typeRequest', null) == 'student');
    }
    match /student_ids/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && studentIdAllowed(getAfter(/databases/$(database)/documents/members/$(uid)).data)
        && request.resource.data.keys().hasOnly(['image', 'createdAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 900000
        && request.resource.data.image.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.createdAt == request.time;
      // 本人も削除できる（種別変更の申請を取り消したときなど）
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- 理事会による入会審査 ----------
    // 理事会のグループと、審査を担当する理事会の設定は管理者のみ
    match /board_groups/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    // 審査の記録（各理事の判断・理由）。書き込みは Cloud Functions のみ、閲覧は管理者のみ
    // ※ 理事は review.html（Cloud Functions 経由）で自分の回答だけを扱う。申込者は読めない
    match /reviews/{id} { allow read: if isAdmin(); allow write: if false; }

    // ---------- 電子同意書 ----------
    // 公開後は本文・版・ハッシュなどを変更できない（改ざん防止）。状態（公開中→受付終了）などは変更可
    match /consent_forms/{id} {
      allow read: if isAdmin()
        || (resource.data.status == 'published'
            && (resource.data.audience in ['public', 'both'] || isActiveMember()));
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        && (resource.data.status == 'draft'
            || !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['title', 'bodyHtml', 'version', 'contentHash', 'audience', 'purpose', 'extraFields', 'publishedAt']))
        && request.resource.data.status in ['draft', 'published', 'closed']
        // 下書きに戻せるのは、まだ公開していないものだけ
        && !(resource.data.status != 'draft' && request.resource.data.status == 'draft');
      allow delete: if isAdmin() && (resource.data.status == 'draft' || isOwner());
    }

    // 署名の記録：作成のみ（変更不可）。封印（seal）は Cloud Functions が付ける
    function consentForm(fid) { return get(/databases/$(database)/documents/consent_forms/$(fid)).data; }
    function validSignature(d) {
      return d.keys().hasOnly(['formId', 'formTitle', 'formVersion', 'formHash', 'signerType', 'uid', 'name', 'email',
               'extra', 'signatureImage', 'signatureHash', 'clientSignedAt', 'userAgent', 'recordHash', 'agreedAt'])
        && consentForm(d.formId).status == 'published'
        && d.formHash == consentForm(d.formId).contentHash
        && d.formVersion == consentForm(d.formId).version
        && str(d.name, 100) && d.name.size() > 0
        && str(d.email, 200) && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.extra is map && d.extra.size() <= 5
        && d.signatureImage is string && d.signatureImage.size() <= 300000
        && d.signatureImage.matches('^data:image/png;base64,.*')
        && str(d.signatureHash, 64) && d.signatureHash.size() == 64
        && str(d.recordHash, 64) && d.recordHash.size() == 64
        && str(d.clientSignedAt, 40) && str(d.userAgent, 300) && str(d.formTitle, 300)
        && d.agreedAt == request.time;
    }
    match /consent_signatures/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validSignature(request.resource.data) && (
        // 会員：会員向けの同意書に、1 回だけ
        (request.resource.data.signerType == 'member' && isActiveMember()
          && request.resource.data.uid == request.auth.uid
          && id == request.resource.data.formId + '_' + request.auth.uid
          && consentForm(request.resource.data.formId).audience in ['members', 'both'])
        // 外部の方：外部向けの同意書に、ログインなしで
        || (request.resource.data.signerType == 'public' && request.resource.data.uid == null
          && consentForm(request.resource.data.formId).audience in ['public', 'both'])
        // 入会申込者：入会規約に、申込直後（審査中）に 1 回だけ
        || (request.resource.data.signerType == 'applicant' && signedIn()
          && request.resource.data.uid == request.auth.uid
          && id == request.resource.data.formId + '_' + request.auth.uid
          && consentForm(request.resource.data.formId).purpose == 'membership'
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'pending')
      );
      allow update: if false;
      // 監査のため削除はオーナーのみ
      allow delete: if isOwner();
    }
    // 封印の連鎖の先頭（Cloud Functions のみ）
    match /consent_chain/{id} { allow read, write: if false; }

    match /member_news/{id} { allow read: if isActiveMember() || isAdmin(); allow write: if isAdmin(); }
    match /member_docs/{id} { allow read: if isActiveMember() || isAdmin(); allow write: if isAdmin(); }

    // ---------- 行事の参加登録（ID = 行事ID_UID） ----------
    match /rsvps/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActiveMember()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'name', 'createdAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
