rules_version = '2';
// ============================================================
//  Firebase Storage セキュリティルール
//  - content/     : お知らせ・会員向けお知らせ・同意書に載せる画像（誰でも閲覧可、管理者のみアップロード）
//  - member_docs/ : 会員限定資料のファイル（有効な会員と管理者のみ閲覧、管理者のみアップロード）
//  ※ 管理者かどうかは Firestore の admins コレクションで判定します
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    // 2 段階認証を設定している人は、このログインでコードを確認するまで「ログインしていない」扱い（firestore.rules と同じ）
    function signedIn() {
      return request.auth != null
        && (request.auth.token.get('mfa', false) != true
            || request.auth.token.auth_time in request.auth.token.get('mfaAts', [])
            || request.auth.token.get('mfaAt', 0) == request.auth.token.auth_time);
    }
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /content/{file=**} {
      allow read: if true;
      // 画像のみ・10MB まで
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // 会員限定資料（PDF・動画・音声・画像・Office ファイルなど）
    // 閲覧は有効な会員と管理者のみ、アップロード・削除は管理者のみ（1 ファイル 2GB まで）
    function isActiveMember() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.status == 'active';
    }
    match /member_docs/{file=**} {
      allow read: if isAdmin() || isActiveMember();
      allow create, update: if isAdmin() && request.resource.size < 2 * 1024 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // それ以外は誰も読み書きできない
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
